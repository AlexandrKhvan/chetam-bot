# Telegram Bot Token from @BotFather (required)
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot (leave empty to allow anyone)
# Tip: send /start to @userinfobot to find your Telegram ID
ALLOWED_USER_IDS=

# Path to SQLite database file
DATABASE_PATH=data/chetam.db

# Public HTTPS URL for Telegram Mini App (e.g. https://3-106-193-6.sslip.io)
WEBAPP_URL=

# Default timezone (IANA name, e.g. Asia/Yekaterinburg, Europe/Moscow, Australia/Sydney)
DEFAULT_TIMEZONE=Asia/Yekaterinburg

# Default daily reminder times (HH:MM, 24-hour format)
DEFAULT_EVENING_PLAN_TIME=21:00
DEFAULT_MORNING_DIGEST_TIME=08:00

# Optional: Vision / LLM / Voice provider (photos, voice transcription, Sunday AI review)
# Supported providers: none, gemini, openai, bedrock
VISION_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: AWS region, Bedrock model, and daily SQLite S3 auto-backup
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=backups/chetam

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
